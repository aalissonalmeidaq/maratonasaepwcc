# =============================================================================
# Variáveis PÚBLICAS do frontend (Vite). Tudo com prefixo VITE_ vai para o navegador
# e pode ser lido por qualquer pessoa. NUNCA coloque aqui service_role, sb_secret_,
# senhas, tokens privados ou a URL do banco (a aplicação recusa chaves secretas).
#
# Copie para .env.local (ignorado pelo git) e ajuste.
# =============================================================================

# URL da API do Supabase.
# Local (supabase start neste projeto): http://127.0.0.1:54421
VITE_SUPABASE_URL=

# Chave PÚBLICA (anon / publishable). Local: copie "PUBLISHABLE_KEY" de `supabase status`.
VITE_SUPABASE_ANON_KEY=

# Modo demonstração com dados fictícios e SEM autenticação real.
# - "true": força a demonstração (ignora o Supabase).
# - vazio: em `npm run dev` sem Supabase configurado, a demonstração é usada;
#          em build de produção sem Supabase, a aplicação mostra "não configurada".
# Nunca habilite em homologação com dados reais nem em produção.
VITE_DEMO_MODE=
